# Local development overrides — copy to `.env` to use.
# All values match the defaults; tweak as needed.

PORT=5001
HOST=127.0.0.1
LOG_LEVEL=INFO

# Set to a real NATS URL in dev/staging/prod. `memory://` disables the
# bus entirely and is what the test suite uses.
BUS_URL=memory://

# Where Syft's workspace will live. On macOS the default
# `/var/lib/...` is not writable — override for local dev.
SBOM_WORKSPACE=/tmp/sbom-workspace

# Path to the Syft binary. Defaults to `syft` on $PATH.
# SYFT_BINARY=/usr/local/bin/syft

# Concurrency cap. Bump with care — each slot is a Syft subprocess.
MAX_CONCURRENT_SCANS=4

# Per-request timeout. Generous default to accommodate large images.
REQUEST_TIMEOUT_SECONDS=600

# When true, requires Authorization: Bearer … and X-Tenant-Id.
REQUIRE_AUTH=false

# T-07 SSRF defense. Git-host allow-list (default-deny when non-empty).
# SBOM_GENERATOR_GIT_HOST_ALLOWLIST=github.com,*.github.com,gitlab.com,*.gitlab.com,bitbucket.org,*.bitbucket.org

# Registry-host allow-list for docker-image/oci-image/registry sources.
# Default: Docker Hub, GHCR, ECR public, Quay, GitLab.com. Bare image
# refs (no explicit host, e.g. "nginx:1.25") always resolve to Docker
# Hub and skip this list. Adding a private registry is an explicit
# operator opt-in — the same blocklist + DNS-rebind checks still apply.
# SBOM_GENERATOR_SSRF_REGISTRY_HOST_ALLOWLIST=docker.io,registry-1.docker.io,index.docker.io,ghcr.io,public.ecr.aws,quay.io,registry.gitlab.com

# SBOM_GENERATOR_SSRF_DEFAULT_DENY=true
# SBOM_GENERATOR_SSRF_DNS_TIMEOUT_SECONDS=5.0
