# =============================================================================
# AI-DevSecOps-Command-Center - Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit a real .env file.
# =============================================================================

# ----- General -----
NODE_ENV=development
LOG_LEVEL=info
APP_NAME=ai-devsecops-command-center
APP_VERSION=0.1.0
APP_PORT=3000
APP_URL=http://localhost:3000

# ----- Frontend (AionUi) -----
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_APP_NAME=AI-DevSecOps Command Center

# ----- Backend services -----
# Each service runs on its own port; defaults shown. docker-compose.yml
# sets PORT explicitly per container — these are for local (non-docker) dev.
AUTH_SERVICE_PORT=3001
AGENT_SERVICE_PORT=3002
SECURITY_SERVICE_PORT=3003
INCIDENT_SERVICE_PORT=3004
COMPLIANCE_SERVICE_PORT=3005
INTEGRATION_SERVICE_PORT=3006
KUBERNETES_SERVICE_PORT=4006
K8S_HEALTH_SERVICE_PORT=4007
RUNTIME_SECURITY_SERVICE_PORT=4008
INVENTORY_SERVICE_PORT=4009
COST_INTELLIGENCE_SERVICE_PORT=4010
TOPOLOGY_SERVICE_PORT=4011
REPORTING_SERVICE_PORT=4012

# ----- Auth / Security -----
# Shared HS256 secret every service verifies tokens against (same value
# everywhere — auth-service issues, every other service verifies).
AUTH_JWT_SECRET=dev-secret-change-me-please-32-chars-min
AUTH_JWT_ISSUER=aicc
AUTH_JWT_AUDIENCE=aicc-api
# docker-compose sets this to false so the stack exercises real auth end
# to end; set to true for quick local (non-docker) dev without a token.
AUTH_DEV_BYPASS=false
JWT_ACCESS_TTL=900            # 15 min
JWT_REFRESH_TTL=2592000       # 30 days
SESSION_SECRET=change-me-too
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=change-me-32-bytes-base64

# ----- HTTP hardening (S7-4, docs/adr/0018-http-hardening.md) -----
# Every backend service reads these (backend/packages/shared/src/http).
# Unset = every service is same-origin only: the SPA reaches them via the
# vite/nginx `/api/*` proxy (see frontend/proxy-table.mjs), never directly,
# so no browser origin needs to be allow-listed by default.
CORS_ORIGINS=
# Max request body size, in bytes, before a 413. A few routes that
# legitimately take larger payloads (SBOM generate/analyze/ingest,
# vulnerability ingest in security-service; webhook ingest in
# integration-service) set a higher per-route limit.
BODY_LIMIT_BYTES=1048576
# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW ms,
# keyed by the verified user id (falls back to IP). /healthz, /readyz,
# /metrics are always exempt.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000
# Comma-separated IP/CIDR allow-list for trusted `X-Forwarded-*` senders.
# Default covers the vite dev proxy (loopback) and the docker-compose
# `ccnet` network (pinned to 172.28.0.0/16 in docker-compose.yml).
TRUST_PROXY_CIDR=127.0.0.1,172.28.0.0/16

# kubernetes-service: AES-256-GCM keyring for cluster credentials at rest
# (token/CA bundle), see docs/adr/0016. Format: keyId:base64key[,keyId:base64key...]
# (first entry is the active key). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset in dev = credentials stored in plaintext with a one-time warning;
# a production boot without a valid keyring refuses to start.
AICC_CREDENTIAL_KEYS=v1:change-me-generate-a-real-32-byte-base64-key

# ----- Database -----
# Postgres. Each service owns its own logical database
# (aicc_auth, aicc_security, aicc_incident, aicc_compliance,
# aicc_integration, aicc_kubernetes — see
# infra/docker/init/postgres-databases.sql); this is a representative
# example, not a value any service reads directly.
DATABASE_URL=postgres://aicc:aicc@localhost:5432/aicc_auth
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_TLS=false

# ----- Event bus (S6-3) -----
# memory (default, in-process, no broker) or redis (Redis Streams,
# one consumer group per service — see docs/adr/0014). Reads REDIS_URL.
EVENT_BUS_DRIVER=memory

# ----- Observability -----
# The OTel collector reads these at startup (see
# `infra/observability/otel-collector/collector-config.yaml`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-devsecops-command-center
PROMETHEUS_PORT=9090
PROM_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:4317
GRAFANA_URL=http://localhost:3011
# Alertmanager: where Prometheus sends alerts
ALERTMANAGER_URL=http://alertmanager:9093
# Runbook base URL for alert annotations (parameterize once hosting is decided)
RUNBOOK_BASE_URL=https://runbooks.example.com/observability
# Dashboard base URL for alert annotations (Grafana root, alerts append /d/<dashboard>)
DASHBOARD_BASE_URL=http://localhost:3011

# ----- GitHub integration -----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_DEFAULT_BRANCH=main

# ----- AI / Model providers -----
# Used by agents — keep keys out of source control
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AIONRS_BASE_URL=
AIONRS_API_KEY=
AIONRS_DEFAULT_MODEL=MiniMax-M3

# ----- Feature flags -----
FEATURE_GITHUB_INTEGRATION=true
FEATURE_SBOM_ATTACHMENT=true
FEATURE_AUTO_INCIDENT=true
FEATURE_COMPLIANCE_EVIDENCE=true

# ----- Compliance / Audit -----
AUDIT_LOG_RETENTION_DAYS=365
EVIDENCE_BUCKET=command-center-evidence
EVIDENCE_SIGNING_KEY=
