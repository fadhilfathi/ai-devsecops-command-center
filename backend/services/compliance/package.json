{
  "name": "@aicc/compliance-service",
  "version": "0.1.0",
  "description": "AICC Compliance Service — CIS/NIST/SOC2/ISO 27001 control mapping, audit evidence",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aicc/observability": "workspace:*",
    "@aicc/shared": "workspace:*",
    "fastify": "^5.12.7",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  }
}
