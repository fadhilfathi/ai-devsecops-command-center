{
  "name": "@aicc/reporting-service",
  "version": "0.1.0",
  "description": "AICC Reporting Service — Cluster Health, Infrastructure Risk, Runtime Security, Cost Optimization, Topology, and Executive Infrastructure Summary reports (PDF / Markdown / JSON)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aicc/models": "workspace:*",
    "@aicc/observability": "workspace:*",
    "@aicc/shared": "workspace:*",
    "fastify": "^5.12.5",
    "pdfkit": "^0.20.2",
    "pino-pretty": "^13.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.7.0"
  }
}
