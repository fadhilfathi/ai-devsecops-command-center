PORT=4012
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# When set, the report service calls these other services over HTTP.
# When unset, the in-process fixture provider is used.
KUBERNETES_SERVICE_URL=
K8S_HEALTH_SERVICE_URL=
RUNTIME_SECURITY_SERVICE_URL=
INVENTORY_SERVICE_URL=
COST_INTELLIGENCE_SERVICE_URL=
TOPOLOGY_SERVICE_URL=

# --- Auth — shared HS256 secret every service verifies tokens against ---
AUTH_JWT_SECRET=dev-secret-change-me-please-32-chars-min
AUTH_JWT_ISSUER=aicc
AUTH_JWT_AUDIENCE=aicc-api
# Trust x-tenant-id/x-user-id headers when no bearer token is present.
# Defaults to true outside production; set to false to exercise real auth locally.
AUTH_DEV_BYPASS=true
