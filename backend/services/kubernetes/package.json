{
  "name": "@aicc/kubernetes-service",
  "version": "0.1.0",
  "description": "AICC Kubernetes Service — cluster inventory, namespace/workload/pod/service/ingress/deployment/statefulset/daemonset inventory, connection test",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests --testTimeout=30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aicc/models": "workspace:*",
    "@aicc/observability": "workspace:*",
    "@aicc/shared": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  }
}
