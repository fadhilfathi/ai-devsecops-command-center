# Kubernetes integration service
PORT=4006
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Default tenant — used when an unauthenticated request needs a
# context. Production deployments use the JWT-derived tenant id.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# Default Kubernetes provider: `fixture` (deterministic, no network) or
# `live` (@kubernetes/client-node against a real API server). The live
# provider requires a cluster onboarded with a `server` + `token` via
# the cluster repository — see docs/adr/0009-live-kubernetes-provider.md.
AICC_K8S_PROVIDER=fixture
# Postgres connection string. Unset = in-memory cluster registry (dev default).
# DATABASE_URL=postgres://aicc:aicc@localhost:5432/aicc_kubernetes

# --- Auth — shared HS256 secret every service verifies tokens against ---
AUTH_JWT_SECRET=dev-secret-change-me-please-32-chars-min
AUTH_JWT_ISSUER=aicc
AUTH_JWT_AUDIENCE=aicc-api
# Trust x-tenant-id/x-user-id headers when no bearer token is present.
# Defaults to true outside production; set to false to exercise real auth locally.
AUTH_DEV_BYPASS=true
