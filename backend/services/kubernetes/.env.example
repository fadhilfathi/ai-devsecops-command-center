# Kubernetes integration service
PORT=4006
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Default tenant — used when an unauthenticated request needs a
# context. Production deployments use the JWT-derived tenant id.
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# Default Kubernetes provider: `fixture` (deterministic, no network) or
# `live` (@kubernetes/client-node against a real API server). The live
# provider requires a cluster onboarded with a `server` + `token` via
# the cluster repository — see docs/adr/0009-live-kubernetes-provider.md.
AICC_K8S_PROVIDER=fixture
